{"id":"p526cb1ae-44","kind":"특별약관","label":"특별약관","name":"종업원 재난배상책임 부담보 특별약관","section":"재난배상책임보장 특별약관","bundle":null,"owner":"무배당 메리츠 재물보험 성공메이트2610","no":"20-1","pages":[170,170],"start":[170,0,48.1],"end":[170,1,48.1],"head":[{"t":"제목","text":"20-1. 종업원 재난배상책임 부담보특별약관","p":170,"c":0,"y0":48.1,"y1":75.7}],"arts":[{"label":"제1조","title":"보상하지 않는 손해","gwan":null,"text":"제1조(보상하지 않는 손해)","p":170,"c":0,"y0":93.4,"y1":103.4,"blocks":[{"t":"문단","text":"재난배상책임보장 특별약관 제1조(보상하는 손해)의 규정에도 불구하고 회사는 보험증권에 기재된 물건의 화재, 폭발, 붕괴로 종업원이 사망하거나 부상함으로써 피보험자가 재난배상책임에 따라 부담할 손해를 보상하지 않습니다.","p":170,"c":0,"y0":106.4,"y1":168.3}]},{"label":"제2조","title":"준용규정","gwan":null,"text":"제2조(준용규정)","p":170,"c":0,"y0":185.4,"y1":195.3,"blocks":[{"t":"문단","text":"이 특별약관에 정하지 않은 사항은 보통약관을 따릅니다.","p":170,"c":0,"y0":198.4,"y1":221.4},{"t":"각주","text":"※ 이 특별약관은 피보험자가 산업재해보상보험에가입된 경우 피보험자의 요청에 따라 발급 됩니다.","p":170,"c":0,"y0":238.4,"y1":261.3}]}]}